{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/claude",
      "dest": "/api/claude.js"
    },
    {
      "src": "/api/generate-slides",
      "dest": "/api/generate-slides.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
